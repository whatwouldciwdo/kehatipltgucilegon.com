# Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Server only. Jangan gunakan prefix NEXT_PUBLIC_ untuk nilai berikut.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CMS_USERNAME=admin
# Buat dengan: npm run cms:hash-password -- "kata-sandi-minimal-12-karakter"
CMS_PASSWORD_HASH=your-scrypt-salt:your-scrypt-hash
# Gunakan nilai acak minimal 32 karakter, contoh: openssl rand -base64 48
CMS_SESSION_SECRET=replace-with-a-long-random-secret